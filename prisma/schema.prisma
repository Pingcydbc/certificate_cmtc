datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. โครงการ (ทำหน้าที่เป็นโฟลเดอร์แยกข้อมูล)
model Project {
  id          String   @id @default(uuid())
  code        String   @unique // รหัสอ้างอิง เช่น NSDV-2569
  title       String   // ชื่อโครงการ
  description String?  // รายละเอียดโครงการ
  eventDate   String?  // วันที่จัดงาน (แสดงบนเกียรติบัตร)
  location    String?  // สถานที่จัดงาน
  isActive    Boolean  @default(true) // เปิดให้ User ค้นหาหรือไม่
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // ผู้สร้างโครงการ (Created By)
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  template    CertificateTemplate?
  recipients  Recipient[]
}

// 2. แม่แบบเกียรติบัตรของแต่ละโครงการ
model CertificateTemplate {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backgroundImage String   // path/URL รูปพื้นหลังเกียรติบัตร
  width           Int      @default(990)
  height          Int      @default(698)
  createdAt       DateTime @default(now())
  elements        TemplateElement[]
}

// 3. องค์ประกอบตัวหนังสือและรูปภาพบนเกียรติบัตร
model TemplateElement {
  id           String              @id @default(uuid())
  templateId   String
  template     CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  elementType  String              // "dynamic", "static", "image"
  fieldKey     String              // "certNumber", "fullName", "organization", "customText", "image"
  defaultValue String?             // สำหรับข้อความ: ข้อความ / สำหรับรูปภาพ: URL รูปภาพ
  posX         Float               // พิกัดแกน X (พิกเซล หรือ %)
  posY         Float               // พิกัดแกน Y (พิกเซล หรือ %)
  fontSize     Int                 @default(24) // ขนาดตัวอักษร
  fontFamily   String              @default("Sarabun")
  fontColor    String              @default("#000000")
  textAlign    String              @default("center") // center, left, right
  lineHeight   Float               @default(1.5)      // เว้นบรรทัดแบบกำหนดเอง
  maxWidth     Int?                // ความกว้างสูงสุดก่อนตัดคำขึ้นบรรทัดใหม่

  // สไตล์ตัวหนังสือเพิ่มเติม
  fontWeight   String?             @default("normal") // "normal" | "bold"
  fontStyle    String?             @default("normal") // "normal" | "italic"
  isUnderline  Boolean?            @default(false)    // ขีดเส้นใต้
  letterSpacing Float?             @default(0)        // ระยะห่างตัวอักษร
  opacity      Float?              @default(1.0)      // ความโปร่งใส (0.1 - 1.0)

  // คุณสมบัติสำหรับรูปภาพ (elementType = "image")
  width        Float?                                 // ความกว้างรูปภาพ (px)
  height       Float?                                 // ความสูงรูปภาพ (px)
}

// 4. ข้อมูลรายชื่อผู้รับเกียรติบัตร
model Recipient {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  certNumber   String   // เช่น NSDV-2569-ผจร.0001
  fullName     String   // เช่น นายสุรศักดิ์ ยะกัน (Trim whitespace เรียบร้อย)
  organization String?  // เช่น วิทยาลัยเทคนิคตาก
  note         String?  // หมายเหตุ
  issuedDate   DateTime @default(now())

  @@index([fullName])
  @@index([certNumber])
  @@index([projectId, fullName])
  @@index([projectId, certNumber])
}

// 5. ข้อมูลผู้ดูแลระบบ (Admin)
model AdminUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // รหัสผ่านที่เข้ารหัสแล้ว (Hash)
  name      String?  // ชื่อผู้ดูแลระบบ
  role      String    @default("user") // "admin" | "user"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[] // โครงการที่ User คนนี้สร้าง
}

